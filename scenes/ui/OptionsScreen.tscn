[node name="InstructionsLabel" type="Label" parent="PanelCenter/Panel/ContentMargin/InstructionsPage/InstructionsScroll"]
unique_name_in_owner = true
custom_minimum_size = Vector2(670, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "GOAL\nReach 100% moonbase readiness before competing factions.\n\nSTRATEGY\nSelect a launch vehicle based on payload capacity, fuel requirement, launch duration, and cargo-grid size.\n\nASSIGN CARGO\nChoose cargo-piece copies and assign fuel or construction materials to them. Include enough fuel for the selected vehicle, then confirm the assignment.\n\nPACK THE VEHICLE\nSelect an assigned piece and fit it into the cargo grid. Empty grid spaces are allowed.\n\nCONTROLS\n• Left-click an empty grid cell to place the selected piece.\n• Left-click a placed piece to pick it up and move it.\n• Right-click a placed piece to remove it from the grid.\n• Press R or use the Rotate button to rotate the selected piece.\n\nLAUNCH RESULTS\nSuccessful launches deliver placed non-fuel materials to the moonbase. Fuel does not increase readiness. Too little placed fuel causes a crash: the cargo is lost and time still advances."
autowrap_mode = 3

